<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= categoryName %></title>
</head>
<body>
  <%- include('./partials/nav') %>

  <h1><%= categoryName %></h1>

  <% menuItems.forEach(item => { %>
    <div>
      <h3><%= item.name %></h3>
      <p>Price: $<%= item.price.toFixed(2) %></p>
      <p>Rating: <%= item.rating %>/5</p>
      <p><%= item.details %></p>
    </div>
  <% }); %>
</body>
</html>